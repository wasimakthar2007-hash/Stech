# Local development uses a persistent SQLite database in data/attendance.sqlite.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=set-this-to-the-admin-password-you-selected

# Optional for hosted deployments: set a Neon/Postgres connection string.
# Hosted deployments also need SETUP_KEY to initialize the database.
DATABASE_URL=
SETUP_KEY=replace-with-a-one-time-setup-key
