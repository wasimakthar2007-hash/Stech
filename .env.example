# Local development uses data/attendance.sqlite if no Postgres URL is set.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=set-this-to-your-private-admin-password

# Optional locally. On Vercel, configure a persistent Neon/Postgres URL.
# DATABASE_URL takes precedence; the other names are recognized if it is absent.
DATABASE_URL=
POSTGRES_URL=
# Optional aliases, usually supplied by the Vercel Postgres integration.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
# Hosted deployments need SETUP_KEY to initialize the database.
SETUP_KEY=replace-with-a-one-time-setup-key
